#!/bin/sh
# ledpaneld - AN4475-G2 面板指示灯策略守护
#
# 这块板 14 颗面板灯全挂在 PCA9555（i2c 2-0020）上，另有一颗电源灯在 SoC GPIO35。
# DTS 里虽然给 red:los / green:wan-online 绑了 pon0-los / pon0-online 触发器，
# 但本板是贴片 paged BOSA，没有 SFP EEPROM，数字 PON PHY 的 SFP_STA bit0 恒为 0，
# 驱动据此算出的 optical_signal 恒为"有光"，两个触发器因此永远不动作。
# 所以这里在用户态按原厂语义自己算，逐颗灯下发 brightness / timer 触发器。
#
# 语义（可用 /etc/config/ledpanel 逐颗改成 on / off / blink 覆盖）：
#   red:los          无光 1Hz 闪；有光灭
#   green:wan-online 无光灭；有光未注册 1Hz 闪；onu_state=O5 常亮
#   其余灯          见 rule 说明，没有可靠状态源的（语音口、下联 PON）默认不点亮，
#                   不做假指示

# 路径可用环境变量覆盖，只为本机回归测试用；生产环境不要设置
LED_ROOT=${LEDPANEL_LED_ROOT:-/sys/class/leds}
GPIO_DBG=${LEDPANEL_GPIO_DBG:-/sys/kernel/debug/gpio}
RUN_DIR=${LEDPANEL_RUN_DIR:-/var/run/ledpanel}
PON_DBG_OVERRIDE=${LEDPANEL_PON_DBG:-}
CONFIG=ledpanel

# 顺序即页面里的展示顺序
LED_LIST="power los wan downlink sys sys_red vpn wlan usb usb2 sfp voice1 voice2 voice3 voice4"

# config_load / config_get 来自 /lib/functions.sh。用它而不是每颗灯每次 `uci get`：
# 15 颗灯每秒 2~3 次 uci 调用就是 40 多个进程/秒，低端 CPU 扛不住。
# config_load 只 spawn 一次 uci，之后 config_get 是纯 shell 函数。
# 本机跑回归测试时没有这个文件，用 uci get 兜底一份同签名实现。
# 注意：`if ! . file` 拦不住——非交互 shell 里 source 不存在的文件会直接终止脚本，
# 所以必须先判断存在再 source。
if [ -r /lib/functions.sh ]; then
	. /lib/functions.sh
else
	config_load() { :; }
	config_get() {
		_v=$(uci -q get "$CONFIG.$2.$3" 2>/dev/null)
		eval "$1=\"\${_v:-$4}\""
	}
fi

log() {
	logger -t ledpaneld "$*" 2>/dev/null
}

# 名字 -> "sysfs 规则名 脚位"
#
# 第三列是 PCA9555（i2c 2-0020，gpiochip576）上的实际脚位号：
#   P0.0=0 … P0.7=7，P1.0=8 … P1.5=13，P1.6/P1.7 空。
# 电源灯不在扩展器上，走 SoC GPIO35，记 -。
#
# 为什么记脚位：脚位是 PCB 走线，永远不会变；sysfs 名字只是 DTS 里的 label，
# 上游改一次 DTS 这边就全断。label 定位失败时用脚位反查（led_path），
# 页面也按脚位展示，拿万用表对着板子能直接对位。
# 实测对应关系见 /sys/kernel/debug/gpio 的 2-0020 段。
led_spec() {
	case "$1" in
		power)    echo "green:power always_on -" ;;
		los)      echo "red:los pon_los 1" ;;
		wan)      echo "green:wan-online pon_wan 0" ;;
		downlink) echo "green:pon-downlink pon_downlink 2" ;;
		sys)      echo "green:sys always_on 3" ;;
		sys_red)  echo "red:sys always_off 4" ;;
		vpn)      echo "green:vpn vpn_up 5" ;;
		wlan)     echo "green:wlan wlan_sta 6" ;;
		usb)      echo "green:usb usb_present 8" ;;
		usb2)     echo "green:usb2 usb_present 7" ;;
		sfp)      echo "green:2g5-fiber sfp_link 9" ;;
		voice1)   echo "green:voice1 voice_hook 10" ;;
		voice2)   echo "green:voice2 voice_hook 11" ;;
		voice3)   echo "green:voice3 voice_hook 12" ;;
		voice4)   echo "green:voice4 voice_hook 13" ;;
		*)        echo "" ;;
	esac
}

# 脚位号 -> 面板丝印（页面显示用）
pin_name() {
	case "$1" in
		''|-) echo "-" ;;
		[0-7]) echo "P0.$1" ;;
		8) echo "P1.0" ;; 9) echo "P1.1" ;; 10) echo "P1.2" ;;
		11) echo "P1.3" ;; 12) echo "P1.4" ;; 13) echo "P1.5" ;;
		14) echo "P1.6" ;; 15) echo "P1.7" ;;
		*) echo "-" ;;
	esac
}

# label 落成真实 sysfs 目录。
# 常态直接命中 $LED_ROOT/<label>；命中不了说明 DTS 改了 label，
# 这时按脚位去 debugfs 查这一脚当前被谁占着，改用那个名字，不用改代码。
# 只匹配 2-0020 那一段：SoC 的 gpiochip 也有 0~15 这些号，混起来会串到别的灯。
led_path() {
	_lbl=$1
	_pin=$2
	if [ -d "$LED_ROOT/$_lbl" ]; then
		printf '%s' "$LED_ROOT/$_lbl"
		return 0
	fi
	case "$_pin" in ''|-|*[!0-9]*) return 1 ;; esac
	[ -r "$GPIO_DBG" ] || return 1
	_alt=$(awk -v p="gpio-$_pin" '
		/^gpiochip/ { sec = (index($0, "2-0020") > 0); next }
		sec && $1 == p {
			s = $0
			sub(/^[^(]*\(/, "", s); sub(/\).*/, "", s)
			gsub(/[ \t|]/, "", s)
			if (s != "") print s
			exit
		}' "$GPIO_DBG" 2>/dev/null)
	[ -n "$_alt" ] && [ -d "$LED_ROOT/$_alt" ] || return 1
	printf '%s' "$LED_ROOT/$_alt"
}

# 页面展示用的中文说明
# 页面主标题。沿用原厂面板的措辞，用户看到的是"光信号""光纤"这些，
# 不是 los/wan 这种内部代号；内部代号只在悬停提示里出现，方便对照 ubus 输出。
led_label() {
	case "$1" in
		power)    echo "电源" ;;
		los)      echo "光信号" ;;
		wan)      echo "光纤" ;;
		downlink) echo "下联 PON" ;;
		sys)      echo "系统" ;;
		sys_red)  echo "系统红" ;;
		vpn)      echo "VPN" ;;
		wlan)     echo "WLAN" ;;
		usb)      echo "USB" ;;
		usb2)     echo "USB2" ;;
		sfp)      echo "2.5G 光口" ;;
		voice1)   echo "语音 1" ;;
		voice2)   echo "语音 2" ;;
		voice3)   echo "语音 3" ;;
		voice4)   echo "语音 4" ;;
		*)        echo "" ;;
	esac
}

led_desc() {
	case "$1" in
		power)    echo "常亮" ;;
		los)      echo "无光时 1Hz 闪红，有光熄灭" ;;
		wan)      echo "无光灭，有光未注册 1Hz 闪，O5 常亮" ;;
		downlink) echo "下联口有载波时亮（本机型通常无对应 netdev）" ;;
		sys)      echo "系统正常时常亮" ;;
		sys_red)  echo "系统故障告警，默认灭" ;;
		vpn)      echo "VPN 隧道 up 时亮" ;;
		wlan)     echo "有终端关联时亮" ;;
		usb)      echo "USB 总线有设备时亮" ;;
		usb2)     echo "第二路 USB 指示" ;;
		sfp)      echo "2.5G 光口有载波时亮" ;;
		voice1)   echo "FXS 无状态源，默认灭" ;;
		voice2)   echo "FXS 无状态源，默认灭" ;;
		voice3)   echo "FXS 无状态源，默认灭" ;;
		voice4)   echo "FXS 无状态源，默认灭" ;;
		*)        echo "" ;;
	esac
}

# 从多行 key: value 文本里取第一个匹配 key 的值
# busybox 的 sed 不支持 \b，用 awk 定位再切分
field() {
	printf '%s\n' "$ST" | awk -v k="$1" '
		index($0, k) == 0 { next }
		{
			rest = substr($0, index($0, k) + length(k))
			sub(/^[ \t]*/, "", rest)		# 允许 key 与分隔符之间有空格
			c = substr(rest, 1, 1)
			if (c != ":" && c != "=") next
			sub(/^[:=][ \t]*/, "", rest)
			if (match(rest, /^[^ \t]+/))
				print substr(rest, RSTART, RLENGTH)
			exit
		}'
}

num_gt() {
	awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 > b + 0) }'
}

collect_state() {
	ST=""
	_f="$PON_DBG/status"
	if [ -r "$_f" ]; then
		ST=$(cat "$_f" 2>/dev/null)
	elif command -v ponctl >/dev/null 2>&1; then
		ST=$(ponctl --device "$PON_DEV" status 2>/dev/null)
	fi

	# 收光功率优先；拿不到就退回驱动自己的 optical_signal
	_rx=$(field rx_power_dbm)
	if [ -n "$_rx" ]; then
		if num_gt "$_rx" "$LOS_RX"; then
			HAS_LIGHT=1
		else
			HAS_LIGHT=0
		fi
	else
		case "$(field optical_signal)" in
			1|true|yes) HAS_LIGHT=1 ;;
			*)          HAS_LIGHT=0 ;;
		esac
	fi

	_sync=$(field xgtc_sync)
	case "$_sync" in
		sync|locked|ok) SYNC=1 ;;
		*)              SYNC=0 ;;
	esac

	_onu=$(field onu_state)
	case "$_onu" in
		O5|o5) REGISTERED=1 ;;
		*)     REGISTERED=0 ;;
	esac
}

netdev_up() {
	[ -n "$1" ] || return 1
	[ "$(cat "/sys/class/net/$1/operstate" 2>/dev/null)" = up ]
}

carrier_on() {
	[ -n "$1" ] || return 1
	[ "$(cat /sys/class/net/"$1"/carrier 2>/dev/null)" = 1 ]
}

any_iface_up() {
	for _i in $1; do
		netdev_up "$_i" && return 0
	done
	return 1
}

wlan_stations() {
	# 有 iw 就数关联终端；没有就退回接口是否 up
	if command -v iw >/dev/null 2>&1; then
		for _i in $WLAN_IFACE; do
			_n=$(iw dev "$_i" station dump 2>/dev/null | grep -c '^Station')
			[ "$_n" -gt 0 ] 2>/dev/null && return 0
		done
		return 1
	fi
	any_iface_up "$WLAN_IFACE"
}

usb_present() {
	for _d in /sys/bus/usb/devices/*-*; do
		[ -d "$_d" ] || continue
		# 排除接口节点（形如 1-1:1.0 / 2-1.2:1.0），只要设备节点
		case "${_d##*/}" in
			*:*) continue ;;
		esac
		return 0
	done
	return 1
}

voice_hook() {
	# 本机型 FXS 没有 sysfs 状态源。留一个外部命令钩子，未配置时视为未摘机。
	[ -n "$1" ] || return 1
	sh -c "$1" >/dev/null 2>&1
}

# 规则 -> on / off / blink:<ms>
rule_state() {
	case "$1" in
		always_on)  echo on ;;
		always_off) echo off ;;
		pon_los)
			if [ "$HAS_LIGHT" = 1 ]; then echo off; else echo "blink:$BLINK_MS"; fi ;;
		pon_wan)
			if [ "$REGISTERED" = 1 ]; then
				echo on
			elif [ "$HAS_LIGHT" = 1 ]; then
				echo "blink:$BLINK_MS"
			else
				echo off
			fi ;;
		pon_downlink)
			# FTTR 下联口，本机型没有对应 netdev 时保持熄灭
			if [ -n "$DOWNLINK_IFACE" ] && carrier_on "$DOWNLINK_IFACE"; then echo on; else echo off; fi ;;
		vpn_up)
			if any_iface_up "$VPN_IFACE"; then echo on; else echo off; fi ;;
		wlan_sta)
			if wlan_stations; then echo on; else echo off; fi ;;
		usb_present)
			if usb_present; then echo on; else echo off; fi ;;
		sfp_link)
			if carrier_on "$SFP_IFACE"; then echo on; else echo off; fi ;;
		voice_hook)
			if voice_hook "$VOICE_CMD"; then echo on; else echo off; fi ;;
		*) echo off ;;
	esac
}

# 只在目标状态变化时才写 sysfs：timer 触发器每写一次都会把闪烁相位打回起点
# $2 是 led_path 解析出来的真实目录，不是 label —— 目录不存在就什么都不做
apply_led() {
	_name=$1; _p=$2; _want=$3
	[ -n "$_p" ] && [ -d "$_p" ] || return 0

	_cache="$RUN_DIR/$_name"
	_prev=$(cat "$_cache" 2>/dev/null)

	# 缓存只证明"我上次想设成什么"，不证明"现在还是这个状态"。
	# /etc/init.d/led（START=96）会按 uci 里的 sysfs 重新绑 netdev 触发器，
	# 手动 echo 也能改；只比对缓存的话，这种外部改动会被永远忽略，
	# 灯就停在别人设的状态上（实测 wlan 灯被 uci 抢走后一直回不来）。
	# 所以缓存命中时再核一次 trigger 名：on/off 要 none，闪烁要 timer。
	# 用 read 内建读，不 fork 进程；brightness 不核 —— timer 闪烁时它自己在变。
	_need=none
	case "$_want" in blink:*) _need=timer ;; esac
	if [ "$_prev" = "$_want" ]; then
		_line=
		read -r _line < "$_p/trigger" 2>/dev/null
		case "$_line" in
			*\["$_need"\]*) return 0 ;;
		esac
	fi

	case "$_want" in
		on)
			echo none > "$_p/trigger" 2>/dev/null
			echo "$(cat "$_p/max_brightness" 2>/dev/null || echo 1)" > "$_p/brightness" 2>/dev/null
			;;
		off)
			echo none > "$_p/trigger" 2>/dev/null
			echo 0 > "$_p/brightness" 2>/dev/null
			;;
		blink:*)
			_d=${_want#blink:}
			echo timer > "$_p/trigger" 2>/dev/null
			echo "$_d" > "$_p/delay_on" 2>/dev/null
			echo "$_d" > "$_p/delay_off" 2>/dev/null
			;;
	esac

	printf '%s' "$_want" > "$_cache"
}

load_config() {
	config_load "$CONFIG"
	config_get ENABLED       settings enabled           1
	config_get INTERVAL      settings interval          1
	config_get PON_DEV       settings pon_device        pon0
	config_get LOS_RX        settings los_rx_threshold  -25
	config_get BLINK_MS      settings blink_ms          500
	config_get VPN_IFACE     settings vpn_iface         ""
	config_get WLAN_IFACE    settings wlan_iface        ""
	config_get SFP_IFACE     settings sfp_iface         sfp0
	config_get DOWNLINK_IFACE settings downlink_iface   ""
	config_get VOICE_CMD     settings voice_cmd         ""

	# 每颗灯的模式一次读齐，后面循环里不再碰 uci
	for _n in $LED_LIST; do
		config_get "MODE_$_n" "$_n" mode     auto
		config_get "BMS_$_n"  "$_n" blink_ms ""
	done

	PON_DBG=${PON_DBG_OVERRIDE:-/sys/kernel/debug/airoha-xpon-$PON_DEV}
}

tick() {
	load_config
	collect_state
	NOW=$(date +%s)
	for _n in $LED_LIST; do
		# shellcheck disable=SC2046  # led_spec 返回三个词，需要按词拆
		set -- $(led_spec "$_n")
		[ -n "$1" ] || continue
		_sys=$1
		_rule=$2
		_pin=$3
		eval "_mode=\$MODE_$_n"

		# 页面上的「试亮 N 秒」写 override 文件，到点自动失效回到配置
		_ov="$RUN_DIR/override.$_n"
		if [ -f "$_ov" ]; then
			read -r _omode _oexp < "$_ov" 2>/dev/null
			if [ -n "$_oexp" ] && [ "$NOW" -lt "$_oexp" ] 2>/dev/null; then
				_mode=$_omode
			else
				rm -f "$_ov"
			fi
		fi

		case "$_mode" in
			on)    _want=on ;;
			off)   _want=off ;;
			blink) eval "_bms=\$BMS_$_n"
			       [ -n "$_bms" ] || _bms="$BLINK_MS"
			       _want="blink:$_bms" ;;
			*)     _want=$(rule_state "$_rule") ;;
		esac

		apply_led "$_n" "$(led_path "$_sys" "$_pin")" "$_want"
	done
}

stop_apply() {
	# 守护退出时把灯收干净：业务灯全灭，只留电源与系统灯亮着（设备带电的常规表现）。
	# 不写回 DTS 的 default-trigger —— 那些触发器在本板本来就不动作，
	# 回写只会让灯停在"有光"的假状态上。
	for _n in $LED_LIST; do
		# shellcheck disable=SC2046
		set -- $(led_spec "$_n")
		[ -n "$1" ] || continue
		_p=$(led_path "$1" "$3")
		[ -n "$_p" ] && [ -d "$_p" ] || continue
		printf 'none' > "$_p/trigger" 2>/dev/null
		case "$_n" in
			power|sys) printf '%s' "$(cat "$_p/max_brightness" 2>/dev/null || echo 1)" > "$_p/brightness" 2>/dev/null ;;
			*)         printf '0' > "$_p/brightness" 2>/dev/null ;;
		esac
	done
	rm -f "$RUN_DIR"/* 2>/dev/null
}

mkdir -p "$RUN_DIR"

case "$1" in
	start|"")
		load_config
		log "启动，间隔 ${INTERVAL}s，阈值 ${LOS_RX} dBm"
		trap 'stop_apply; exit 0' TERM INT
		while :; do
			tick
			sleep "$INTERVAL"
		done
		;;
	once)
		# 单次应用，行为与守护主循环完全一致（含 override），页面改完配置立刻生效
		tick
		;;
	state)
		# 给页面看的一次性状态输出
		load_config
		collect_state
		printf 'light=%s sync=%s registered=%s rx=%s onu=%s\n' \
			"$HAS_LIGHT" "$SYNC" "$REGISTERED" "$(field rx_power_dbm)" "$(field onu_state)"
		;;
	spec)
		# name|sysfs|rule|说明|脚位|中文名，给 rpcd 后端和页面共用，避免两处映射漂移
		# sysfs 列给的是 led_path 解析后的真实目录名：DTS 把 label 改了，
		# 这里会自动变成新名字，页面和后端不用知道原来的 label。
		for _n in $LED_LIST; do
			# shellcheck disable=SC2046
			set -- $(led_spec "$_n")
			[ -n "$1" ] || continue
			_p=$(led_path "$1" "$3")
			if [ -n "$_p" ]; then _s=${_p##*/}; else _s=$1; fi
			printf '%s|%s|%s|%s|%s|%s\n' "$_n" "$_s" "$2" "$(led_desc "$_n")" "$(pin_name "$3")" "$(led_label "$_n")"
		done
		;;
	*)
		echo "usage: ledpaneld [start|once|state|spec]" >&2
		exit 1
		;;
esac
