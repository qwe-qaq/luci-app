#!/bin/sh
# 只挂开机自启，不直接 start：本脚本在 boot 阶段先于 rc.d 执行，
# 交给 S99ledpaneld 拉起才不会和 /etc/init.d/led 抢时序。

[ -n "$IPKG_INSTROOT" ] && exit 0

/etc/init.d/ledpaneld enable

# rpcd 只在启动时扫一次 /usr/libexec/rpcd。装包时它已运行，不重启就不会注册
# luci.ledpanel，页面报 -32000 Object not found。boot 阶段 rpcd 通常还没起。
if pidof rpcd >/dev/null 2>&1; then
	ubus list 2>/dev/null | grep -qx "luci.ledpanel" || /etc/init.d/rpcd restart >/dev/null 2>&1
fi

exit 0
